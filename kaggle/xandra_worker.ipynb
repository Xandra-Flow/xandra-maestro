   "source": [
    "# @title ## 🚀 القسم 6: التدريب { display-mode: \"form\" }\n",
    "\n",
    "import time\n",
    "from datetime import datetime, timedelta\n",
    "\n",
    "# إعدادات التدريب\n",
    "MAX_STEPS = 500  # @param {type:\"integer\"}\n",
    "BATCH_SIZE = 32  # @param {type:\"integer\"}\n",
    "LEARNING_RATE = 3e-4  # @param {type:\"number\"}\n",
    "SAVE_EVERY = 50  # @param {type:\"integer\"}\n",
    "MAX_TIME_MINUTES = 700  # @param {type:\"integer\"} (12 ساعة - 20 دقيقة احتياط)\n",
    "\n",
    "optimizer = torch.optim.AdamW(model.parameters(), lr=LEARNING_RATE)\n",
    "model.train()\n",
    "\n",
    "step = state['current_step']\n",
    "start_time = time.time()\n",
    "losses = []\n",
    "\n",
    "print(f'🚀 بدء التدريب من الخطوة {step}')\n",
    "print(f'⏱️  الحد الزمني: {MAX_TIME_MINUTES} دقيقة ({MAX_TIME_MINUTES/60:.1f} ساعة)')\n",
    "print(f'🎯 عدد الخطوات المستهدفة: {MAX_STEPS}')\n",
    "print('=' * 60)\n",
    "\n",
    "for i in range(MAX_STEPS):\n",
    "    # فحص الوقت المتبقي\n",
    "    elapsed = (time.time() - start_time) / 60\n",
    "    if elapsed >= MAX_TIME_MINUTES:\n",
    "        print(f'⏰ انتهى الوقت ({elapsed:.1f} دقيقة)')\n",
    "        break\n",
    "    \n",
    "    # اختيار batch عشوائي\n",
    "    indices = torch.randint(0, len(data), (BATCH_SIZE,))\n",
    "    batch = data[indices].cuda()\n",
    "    \n",
    "    # التدريب\n",
    "    logits, loss = model(batch, targets=batch)\n",
    "    optimizer.zero_grad()\n",
    "    loss.backward()\n",
    "    optimizer.step()\n",
    "    \n",
    "    step += 1\n",
    "    losses.append(loss.item())\n",
    "    \n",
    "    # طباعة التقدم\n",
    "    if i % 10 == 0:\n",
    "        avg_loss = sum(losses[-10:]) / min(10, len(losses))\n",
    "        progress = (i / MAX_STEPS) * 100\n",
    "        print(f'[{datetime.now().strftime(\"%H:%M:%S\")}] خطوة {step} | loss: {loss.item():.4f} | avg: {avg_loss:.4f} | {progress:.1f}%')\n",
    "    \n",
    "    # حفظ checkpoint\n",
    "    if i % SAVE_EVERY == 0 and i > 0:\n",
    "        save_checkpoint(model, optimizer, step, loss.item())\n",
    "\n",
    "print('=' * 60)\n",
    "print(f'✅ انتهى التدريب عند الخطوة {step}')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# @title ## 💾 القسم 7: حفظ النتائج النهائية { display-mode: \"form\" }\n",
    "\n",
    "def save_checkpoint(model, optimizer, step, loss):\n",
    "    \"\"\"حفظ checkpoint ورفعه على HF\"\"\"\n",
    "    checkpoint = {\n",
    "        'model_state': model.state_dict(),\n",
    "        'optimizer_state': optimizer.state_dict(),\n",
    "        'step': step,\n",
    "        'loss': loss,\n",
    "        'timestamp': datetime.now().isoformat()\n",
    "    }\n",
    "    \n",
    "    torch.save(checkpoint, 'latest.pt')\n",
    "    \n",
    "    upload_file(\n",
    "        path_or_fileobj='latest.pt',\n",
    "        path_in_repo='checkpoints/latest.pt',\n",
    "        repo_id=HF_REPO,\n",
    "        repo_type='model',\n",
    "        token=HF_TOKEN\n",
    "    )\n",
    "    print(f'💾 تم حفظ checkpoint عند الخطوة {step}')\n",
    "\n",
    "# حفظ نهائي\n",
    "if losses:\n",
    "    final_loss = losses[-1]\n",
    "    save_checkpoint(model, optimizer, step, final_loss)\n",
    "    \n",
    "    # تحديث state\n",
    "    state['current_step'] = step\n",
    "    state['current_loss'] = final_loss\n",
    "    state['best_loss'] = min(state['best_loss'], final_loss)\n",
    "    state['history'].append({\n",
    "        'timestamp': datetime.now().isoformat(),\n",
    "        'final_step': step,\n",
    "        'final_loss': final_loss,\n",
    "        'steps_done': len(losses)\n",
    "    })\n",
    "    \n",
    "    # الحفاظ على آخر 50 سجل\n",
    "    if len(state['history']) > 50:\n",
    "        state['history'] = state['history'][-50:]\n",
    "    \n",
    "    # حفظ state\n",
    "    with open('state.json', 'w') as f:\n",
    "        json.dump(state, f, indent=2, ensure_ascii=False)\n",
    "    \n",
    "    upload_file(\n",
    "        path_or_fileobj='state.json',\n",
    "        path_in_repo='state.json',\n",
    "        repo_id=HF_REPO,\n",
    "        repo_type='model',\n",
    "        token=HF_TOKEN\n",
    "    )\n",
    "    \n",
    "    print(f'📊 تم تحديث state.json')\n",
    "    print(f'✅ الخطوة النهائية: {step}')\n",
    "    print(f'📉 الخسارة النهائية: {final_loss:.4f}')\n",
    "    print(f'🏆 أفضل خسارة: {state[\"best_loss\"]:.4f}')\n",
    "else:\n",
    "    print('⚠️ لم يتم التدريب، لا يوجد شيء للحفظ')"
   ]
  },

    "# @title ## 🧪 القسم 8: اختبار النموذج { display-mode: \"form\" }\n",
    "\n",
    "model.eval()\n",
    "\n",
    "def generate_text(model, prompt, max_new_tokens=50):\n",
    "    \"\"\"توليد نص من النموذج\"\"\"\n",
    "    tokens = tokenizer(\n",
    "        prompt,\n",
    "        return_tensors='pt',\n",
    "        padding='max_length',\n",
    "        truncation=True,\n",
    "        max_length=128\n",
    "    )['input_ids'].cuda()\n",
    "    \n",
    "    with torch.no_grad():\n",
    "        for _ in range(max_new_tokens):\n",
    "            logits, _ = model(tokens)\n",
    "            next_token = logits[0, -1].argmax().unsqueeze(0).unsqueeze(0)\n",
    "            tokens = torch.cat([tokens, next_token], dim=1)\n",
    "    \n",
    "    return tokenizer.decode(tokens[0], skip_special_tokens=True)\n",
    "\n",
    "# اختبار\n",
    "print('🧪 اختبار توليد النص:')\n",
    "print('-' * 50)\n",
    "\n",
    "prompts = [\n",
    "    'العمارة',\n",
    "    'الزراعة',\n",
    "    'العلوم'\n",
    "]\n",
    "\n",
    "for prompt in prompts:\n",
    "    generated = generate_text(model, prompt, max_new_tokens=30)\n",
    "    print(f'المدخل: {prompt}')\n",
    "    print(f'المخرج: {generated}')\n",
    "    print('-' * 50)\n",
    "\n",
    "print('✅ انتهى! اغلق المتصفح بأمان.')"
   ]
  }

    "# @title ## 💾 القسم 5: تحميل آخر Checkpoint { display-mode: \"form\" }\n",
    "\n",
    "from huggingface_hub import hf_hub_download, upload_file, HfApi\n",
    "import json\n",
    "import os\n",
    "\n",
    "hf_api = HfApi(token=HF_TOKEN)\n",
    "\n",
    "# تحميل state.json\n",
    "def load_state():\n",
    "    try:\n",
    "        path = hf_hub_download(\n",
    "            repo_id=HF_REPO,\n",
    "            filename='state.json',\n",
    "            repo_type='model',\n",
    "            token=HF_TOKEN\n",
    "        )\n",
    "        with open(path) as f:\n",
    "            return json.load(f)\n",
    "    except Exception as e:\n",
    "        print(f'🆕 لا توجد حالة سابقة، بدء جديد: {e}')\n",
    "        return {\n",
    "            'current_step': 0,\n",
    "            'target_steps': 500000,\n",
    "            'current_loss': None,\n",
    "            'history': [],\n",
    "            'best_loss': float('inf')\n",
    "        }\n",
    "\n",
    "state = load_state()\n",
    "print(f'📊 الخطوة الحالية: {state[\"current_step\"]}')\n",
    "print(f'🎯 الهدف: {state[\"target_steps\"]}')\n",
    "if state['current_loss']:\n",
    "    print(f'📉 آخر خسارة: {state[\"current_loss\"]:.4f}')\n",
    "\n",
    "# تحميل آخر checkpoint\n",
    "def load_checkpoint(model):\n",
    "    try:\n",
    "        path = hf_hub_download(\n",
    "            repo_id=HF_REPO,\n",
    "            filename='checkpoints/latest.pt',\n",
    "            repo_type='model',\n",
    "            token=HF_TOKEN\n",
    "        )\n",
    "        checkpoint = torch.load(path, map_location='cuda')\n",
    "        model.load_state_dict(checkpoint['model_state'])\n",
    "        print(f'✅ تم تحميل checkpoint من الخطوة {checkpoint[\"step\"]}')\n",
    "        return checkpoint['step']\n",
    "    except Exception as e:\n",
    "        print(f'🆕 بدء تدريب من الصفر')\n",
    "        return 0\n",
    "\n",
    "model = model.cuda()\n",
    "last_step = load_checkpoint(model)"
   ]
  },
  {
   "cell_type": "code",

    "# @title ## 📚 القسم 4: تحميل Tokenizer وبيانات تدريب { display-mode: \"form\" }\n",
    "\n",
    "from transformers import AutoTokenizer\n",
    "\n",
    "# استخدام tokenizer جاهز (مؤقتاً)\n",
    "print('📚 تحميل Tokenizer...')\n",
    "tokenizer = AutoTokenizer.from_pretrained(\n",
    "    'Qwen/Qwen2.5-Coder-1.5B-Instruct',\n",
    "    use_fast=True\n",
    ")\n",
    "print(f'✅ Tokenizer: {tokenizer.vocab_size} توكن')\n",
    "\n",
    "# بيانات تدريب تجريبية (في الإنتاج: استبدل بمكتبتك)\n",
    "training_texts = [\n",
    "    'العمارة الإسلامية فن راقٍ يمتد عبر القرون',\n",
    "    'الزراعة في مصر القديمة كانت متقدمة جداً',\n",
    "    'الصناعة تحتاج إلى معرفة وخبرة وتدريب',\n",
    "    'اللغة العربية لغة غنية بالمفردات والتراكيب',\n",
    "    'العلوم الرياضية أساس التطور التكنولوجي',\n",
    "    'الحضارة المصرية القديمة من أعرق الحضارات',\n",
    "    'الطب عند العرب كان متقدماً في العصور الوسطى',\n",
    "    'الفلسفة العربية أثرت في الفكر العالمي',\n",
    "    'الكيمياء نشأت عند العرب والمسلمين',\n",
    "    'الفلك علم درسه العرب بعمق',\n",
    "] * 100  # تكرار 100 مرة\n",
    "\n",
    "print(f'✅ عدد النصوص: {len(training_texts)}')\n",
    "\n",
    "# تحويل النصوص إلى tokens\n",
    "def encode_batch(texts, max_len=128):\n",
    "    batch = []\n",
    "    for text in texts:\n",
    "        tokens = tokenizer(\n",
    "            text,\n",
    "            return_tensors='pt',\n",
    "            padding='max_length',\n",
    "            truncation=True,\n",
    "            max_length=max_len\n",
    "        )['input_ids'][0]\n",
    "        batch.append(tokens)\n",
    "    return torch.stack(batch)\n",
    "\n",
    "# تجهيز بيانات التدريب\n",
    "data = encode_batch(training_texts)\n",
    "print(f'✅ شكل البيانات: {data.shape}')\n",
    "print(f'📊 عدد العينات: {len(data)}')"
   ]
  },
